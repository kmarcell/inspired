# fastlane/Fastfile

default_platform(:ios)

platform :ios do
  desc "Verify that Firebase Emulators are running"
  private_lane :verify_emulators do
    begin
      sh("curl -f http://localhost:4000")
    rescue
      UI.user_error!("❌ Firebase Emulators are not running! Please run 'firebase emulators:start' in a separate terminal before running tests.")
    end
  end

  desc "Seed the local emulator with initial data"
  lane :seed_emulator do
    UI.message("🌱 Seeding local emulator...")
    sh("cd ../../../.. && node infrastructure/scripts/seeder.js local")
  end

  desc "Run unit and snapshot tests (Local Emulator). Optional: only_testing:'Tests/ClassName/TestMethod' record_snapshots:true"
  lane :test do |options|
    # Increase timeout for slow showBuildSettings calls
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

    # Set snapshot recording env var if requested
    xcargs = "-skipMacroValidation"
    if options[:record_snapshots]
      xcargs += " RECORD_SNAPSHOTS=1"
    end

    # 0. Load Local Secrets
    Dotenv.load "../../../../.env"
    UI.message("🧪 Fastlane: TEST_USER_PASSWORD is set: #{!ENV['TEST_USER_PASSWORD'].nil?}")

    # 1. Pre-test Automation
    sh("xcodegen generate --spec ../project.yml")
    sh("cd ../../../.. && ./scripts/sync-strings.sh")
    sh("cd ../../../.. && ./scripts/generate-assets.sh")

    # 2. Emulator Verification (Critical for UI Tests)
    verify_emulators

    # 3. Optional/Automatic Seeding
    if options[:reseed]
      seed_emulator
    end

    # 4. Execution
    scan(
      scheme: "Inspired (Local)",
      configuration: "Debug (Local)",
      derived_data_path: "./build",
      xcargs: xcargs,
      only_testing: options[:only_testing],

      # AI Optimization: Suppress raw stdout to save tokens
      suppress_xcode_output: true,
      disable_concurrent_testing: true,

      # Generate machine-readable reports for failure diagnosis
      output_types: "junit,html",
      output_directory: "./fastlane/test_output",
      buildlog_path: "./fastlane/test_output/logs"
    )
  end

  desc "Deploy a new version to Firebase App Distribution (Staging)"
  lane :deploy_staging do
    sh("../../../scripts/fetch-config.sh staging")
    sh("xcodegen generate")

    build_app(
      scheme: "Inspired (Staging)",
      configuration: "Release (Staging)",
      export_method: "ad-hoc"
    )

    firebase_app_distribution(
      app: "1:99296584767:ios:some_app_id",
      groups: "staging-testers"
    )
  end

  desc "Deploy PWA, Firestore rules, indexes & Cloud Functions to Firebase Staging"
  lane :deploy_pwa_staging do
    UI.message("🚀 Deploying Firestore Rules, Indexes, Functions & PWA to Staging...")
    sh("cd ../../../.. && npx firebase deploy --only firestore:rules,firestore:indexes,functions,hosting --project inspired-yoga-app-staging")
  end
    
    desc "Analyze Accessibility (Generate Hierarchy & Screenshots)"
    lane :analyze_accessibility do
      sh("mkdir -p ../../../../Accessibility")
      sh("rm -f ../../../../Accessibility/*")
      scan(
        scheme: "Inspired (Local)",
        configuration: "Debug (Local)",
        only_testing: "InspiredUITests/LoginUITests/testLoginScreenVoiceOver",
        xcargs: "-skipMacroValidation",

        # AI Optimization: Suppress raw stdout to save tokens
        suppress_xcode_output: true,
        disable_concurrent_testing: true,

        # Generate machine-readable reports for failure diagnosis
        output_types: "junit,html",
        output_directory: "./fastlane/test_output",
        buildlog_path: "./fastlane/test_output/logs"
      )
      # Read the generated hierarchy files for AI analysis
      sh("cat ../../../../Accessibility/*.txt")
    end
          
      desc "Deploy a new version to TestFlight (Production)"
  lane :deploy_prod do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    sh("../../../scripts/fetch-config.sh prod")
    sh("xcodegen generate")

    build_app(
      scheme: "Inspired (Production)",
      configuration: "Release (Production)",
      export_method: "app-store"
    )

    upload_to_testflight(api_key: api_key)
  end
end
