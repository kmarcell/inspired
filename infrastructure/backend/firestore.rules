rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requester is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper to check if user is a member of a community
    function isMember(communityId) {
      return request.auth != null && 
             communityId != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'joinedCommunities' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             communityId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunities;
    }

    // Helper to check if a community is public
    function isCommunityPublic(communityId) {
      return communityId != null && 
             exists(/databases/$(database)/documents/communities/$(communityId)) &&
             get(/databases/$(database)/documents/communities/$(communityId)).data.privacySettings.isPublic == true;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth == null || isOwner(userId);
    }
    
    // 2. Yoga Studios & Sub-collections (classes, bookings, members)
    match /studios/{studioId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Communities
    match /communities/{communityId} {
      allow get: if resource.data.privacySettings.isPublic == true || isMember(communityId);
      allow list: if true;
      allow write: if true;
    }
    
    // 4. Community Posts
    match /posts/{postId} {
      // Area posts and public community posts are public. Private community posts require membership.
      allow get, list: if (resource.data.source is map && 'type' in resource.data.source && resource.data.source.type == "area") ||
                          (resource.data.source is map && 'id' in resource.data.source && isCommunityPublic(resource.data.source.id)) || 
                          (resource.data.source is map && 'id' in resource.data.source && isMember(resource.data.source.id));
      allow create: if request.auth != null && 
                      request.resource.data.author.id == request.auth.uid &&
                      (request.resource.data.source.type == "area" || isMember(request.resource.data.source.id));
      allow update, delete: if request.auth != null && resource.data.author.id == request.auth.uid;
    }
    
    // 5. Comments (Sub-collection)
    match /posts/{postId}/comments/{commentId} {
      allow read: if true; // Linked to parent post visibility in real-world, keeping simple for now
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.author.id == request.auth.uid;
    }
    
    // 6. Likes (Sub-collection)
    match /posts/{postId}/likes/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 7. Company Brands
    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // 8. Studio Verification Claims
    match /studioClaims/{claimId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.isAdmin == true);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // 9. Staging Invites Gating
    match /stagingInvites/{inviteId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
  }
}
