{
  "hosting": {
    "public": "Apps/PWA/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "infrastructure/backend/firestore.rules",
    "indexes": "infrastructure/backend/firestore.indexes.json"
  },
  "storage": {
    "rules": "infrastructure/backend/storage.rules"
  },
  "functions": {
    "source": "infrastructure/backend/functions",
    "runtime": "nodejs20"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8081
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    }
  }
}
